# /apps/webapplications/NFA_Approval/Quality/middleware/.env
# chmod 600 after filling in.

# Node listens on localhost; nginx publishes it on port 3004
PORT=3005

# Shared secret. Enter the SAME value in the app:
#   Admin -> SAP API Settings -> Middleware Configuration -> Proxy Secret
# Generate with: openssl rand -hex 32
PROXY_SECRET=<openssl rand -hex 32>

# Optional comma separated IP allow list (empty = allow all).
ALLOW_IPS=

# Upstream SAP timeout. Attachment fetches for large records run 95-170s.
TIMEOUT_MS=180000

# Max JSON body accepted from the app (uploads are base64; UI allows 40 MB).
MAX_BODY=60mb
