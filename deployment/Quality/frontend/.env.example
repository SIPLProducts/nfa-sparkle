# /apps/webapplications/NFA_Approval/Quality/frontend/.env
#
# Used twice:
#   1. BUILD time  -> `set -a; . ./.env; set +a` before `npm run build`
#   2. RUN time    -> EnvironmentFile for the Quality Node SSR service
#
# chmod 600 this file after filling it in.

# --- Node SSR server (nginx :8081 proxies here) ----------------------------
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# --- Server-side Supabase access (never leaves the server) -----------------
SUPABASE_URL=http://127.0.0.1:8001
SUPABASE_PROJECT_ID=enfa-quality
SUPABASE_PUBLISHABLE_KEY=<quality ANON_KEY from ../backend/.env>
SUPABASE_SERVICE_ROLE_KEY=<quality SERVICE_ROLE_KEY from ../backend/.env>

# --- Browser bundle (inlined at BUILD time - rebuild after any change) -----
# The browser talks to the app origin; nginx forwards /auth|rest|realtime|storage/v1
# to the Quality Kong on 127.0.0.1:54321.
VITE_SUPABASE_URL=http://10.200.1.7:8081
VITE_SUPABASE_PROJECT_ID=enfa-quality
VITE_SUPABASE_PUBLISHABLE_KEY=<quality ANON_KEY>

# Never put the service role key in a VITE_ variable - it would ship to the browser.
