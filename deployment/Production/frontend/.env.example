# /apps/webapplications/NFA_Approval/Production/frontend/.env
#
# Used twice:
#   1. BUILD time  -> `set -a; . ./.env; set +a` before `npm run build`
#   2. RUN time    -> EnvironmentFile for the Production Node SSR service
#
# chmod 600 this file after filling it in.

# --- Node SSR server (nginx :8091 proxies here) ----------------------------
HOST=127.0.0.1
PORT=3010
NODE_ENV=production

# --- Server-side Supabase access (never leaves the server) -----------------
SUPABASE_URL=http://127.0.0.1:8011
SUPABASE_PROJECT_ID=enfa-production
SUPABASE_PUBLISHABLE_KEY=<production ANON_KEY from ../backend/.env>
SUPABASE_SERVICE_ROLE_KEY=<production SERVICE_ROLE_KEY from ../backend/.env>

# --- Browser bundle (inlined at BUILD time - rebuild after any change) -----
# The browser talks to the app origin; nginx forwards /auth|rest|realtime|storage/v1
# to the Production Kong on 127.0.0.1:54421.
VITE_SUPABASE_URL=http://10.200.1.7:8091
VITE_SUPABASE_PROJECT_ID=enfa-production
VITE_SUPABASE_PUBLISHABLE_KEY=<production ANON_KEY>

# Never put the service role key in a VITE_ variable - it would ship to the browser.
