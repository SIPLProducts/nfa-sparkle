# Port the middleware listens on (ngrok points here)
PORT=3008

# Shared secret. The same value must be entered in
# API Settings -> Middleware Configuration -> Proxy Secret.
PROXY_SECRET=replace-with-a-long-random-secret

# Optional comma separated IP allow list (leave empty to allow all)
ALLOW_IPS=

# Upstream SAP timeout in milliseconds
TIMEOUT_MS=30000
# Max JSON body accepted from the app (uploads are base64, keep well above 40mb)
MAX_BODY=60mb
