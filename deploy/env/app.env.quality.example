# /opt/enfa/app.env  -  eNFA app env for the QUALITY server
# Copy:   cp deploy/env/app.env.quality.example /opt/enfa/app.env
#         chmod 600 /opt/enfa/app.env
#
# Used twice:
#   1. at BUILD time  ->  set -a; . /opt/enfa/app.env; set +a; npm ci && npm run build
#   2. at RUN time    ->  systemd EnvironmentFile for enfa-app.service

# --- Node server (nginx on 8081 proxies here) ------------------------------
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# --- Self-hosted Supabase on this server -----------------------------------
# Must be the LAN IP of the quality server: the browser has to reach it too.
SUPABASE_URL=http://<SERVER_IP>:8001
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY from /opt/enfa/supabase/.env>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from /opt/enfa/supabase/.env>
SUPABASE_PROJECT_ID=enfa-quality

# --- Same values for the browser bundle ------------------------------------
# IMPORTANT: VITE_* values are inlined at BUILD time. Changing any of them
# requires a rebuild (npm run build), not just a service restart.
VITE_SUPABASE_URL=http://<SERVER_IP>:8001
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
VITE_SUPABASE_PROJECT_ID=enfa-quality

# Never put the service role key in a VITE_ variable - it would ship to the browser.
