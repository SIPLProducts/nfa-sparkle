# /opt/enfa/middleware/.env  -  SAP middleware env for the QUALITY server
# Copy:   cp deploy/env/middleware.env.quality.example /opt/enfa/middleware/.env
#         chmod 600 /opt/enfa/middleware/.env

# Node listens on localhost; nginx publishes it on port 3004
PORT=3005

# Shared secret. Enter the SAME value in the app:
#   Admin -> SAP API Settings -> Middleware Configuration -> Proxy Secret
# Generate with: openssl rand -hex 32
PROXY_SECRET=<openssl rand -hex 32>

# Optional comma separated IP allow list (empty = allow all).
# nginx already fronts this; add the server IP here if you want a second gate.
ALLOW_IPS=

# Upstream SAP timeout. Attachment fetches for large records run 95-170s,
# so keep this above the nginx proxy_read_timeout margin.
TIMEOUT_MS=180000

# Max JSON body accepted from the app. Uploads send files as base64;
# the app allows 40 MB per upload, so keep this above that.
MAX_BODY=60mb
