# /opt/enfa/app.env  -  runtime env for the eNFA app (systemd EnvironmentFile)
# Copy to /opt/enfa/app.env, fill in the values, then: chmod 600 /opt/enfa/app.env

# Where the Node server listens (nginx on 8081 proxies here)
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# --- Self-hosted Supabase on this server -----------------------------------
# Use the LAN IP of the QA server, not localhost: the browser must reach it too.
SUPABASE_URL=http://<SERVER_IP>:8001
SUPABASE_PUBLISHABLE_KEY=<ANON_KEY from supabase/docker/.env>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from supabase/docker/.env>
SUPABASE_PROJECT_ID=enfa-qa

# --- Same values for the browser bundle ------------------------------------
# IMPORTANT: VITE_* values are baked in at BUILD time. They must be present in
# the shell (or a .env file at the repo root) when you run `npm run build`.
# Changing a key means rebuilding, not just restarting.
VITE_SUPABASE_URL=http://<SERVER_IP>:8001
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
VITE_SUPABASE_PROJECT_ID=enfa-qa
