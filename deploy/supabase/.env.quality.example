############################################################
# eNFA QUALITY - Supabase self-hosted stack env
# Copy to /opt/enfa/supabase/.env and fill in every <...>
# chmod 600 .env
############################################################

############
# Secrets  - generate, never reuse across environments
#   openssl rand -hex 24    -> POSTGRES_PASSWORD
#   openssl rand -hex 32    -> JWT_SECRET  (must be 40+ chars)
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET
# (roles "anon" and "service_role", exp ~10 years).
# Generator: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
############
POSTGRES_PASSWORD=<generated-postgres-password>
JWT_SECRET=<generated-40-plus-char-jwt-secret>
ANON_KEY=<anon-jwt>
SERVICE_ROLE_KEY=<service-role-jwt>
SECRET_KEY_BASE=<openssl rand -hex 32>
VAULT_ENC_KEY=<openssl rand -hex 16>

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Ports - kept on localhost; nginx publishes 8001 / 8082
############
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=54322
STUDIO_PORT=54323

############
# Public addresses (what the browser uses) - replace <SERVER_IP>
############
SITE_URL=http://<SERVER_IP>:8081
API_EXTERNAL_URL=http://<SERVER_IP>:8001
SUPABASE_PUBLIC_URL=http://<SERVER_IP>:8001
ADDITIONAL_REDIRECT_URLS=http://<SERVER_IP>:8081

############
# Studio dashboard basic auth
############
DASHBOARD_USERNAME=enfa-admin
DASHBOARD_PASSWORD=<strong-password>
STUDIO_DEFAULT_ORGANIZATION=Ramky
STUDIO_DEFAULT_PROJECT=eNFA Quality

############
# Auth - no SMTP on quality, users are created by the admin
############
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############
# SMTP (leave as-is while autoconfirm is on)
############
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=eNFA Quality

############
# API / storage
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Analytics / functions
############
LOGFLARE_PUBLIC_ACCESS_TOKEN=<openssl rand -hex 16>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<openssl rand -hex 16>
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
FUNCTIONS_VERIFY_JWT=false
POOLER_TENANT_ID=enfa-quality
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DB_POOL_SIZE=5
